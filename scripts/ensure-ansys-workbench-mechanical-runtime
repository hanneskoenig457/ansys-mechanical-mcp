#!/bin/zsh

# Explicitly prepare a Mechanical runtime that lives INSIDE an Ansys Workbench
# project (Project Schematic), as opposed to ensure-ansys-mechanical-runtime
# which starts Mechanical standalone. Both scripts share the same SSH
# ControlMaster socket, so both routes are multiplexed over one SSH TCP
# connection.
#
# Chain: Workbench GUI (gRPC "project server") -> start_mechanical_server()
# for one named system -> that system's own Mechanical gRPC server -> remapped
# onto the same local port (50056) that the official ansys-mechanical MCP is
# already configured to use, so no MCP reconfiguration is needed.
#
# Requires ansys-workbench-core installed in <repository>/.venv
# (pip install ansys-workbench-core).

set -eu
set -o pipefail

SCRIPT_DIR="${0:A:h}"
REPO_DIR="${SCRIPT_DIR:h}"
WINDOWS_BOOTSTRAP="${SCRIPT_DIR}/windows/Start-AnsysWorkbenchGrpc.ps1"
VENV_PYTHON="${REPO_DIR}/.venv/bin/python"

SSH_HOST="${ANSYS_MECHANICAL_SSH_HOST:-ansys-mechanical-vm}"
PARALLELS_VM="${ANSYS_PARALLELS_VM:-Windows 11}"
PARALLELS_VM_BUNDLE="${ANSYS_PARALLELS_VM_BUNDLE:-/Volumes/WindowsVM/Windows 11.pvm}"
ANSYS_VERSION="${ANSYS_VERSION:-251}"
WB_GRPC_PORT="${ANSYS_WORKBENCH_GRPC_PORT:-51000}"
MECH_LOCAL_PORT="${ANSYS_MECHANICAL_GRPC_PORT:-50056}"
PREWARM_ONLY="${ANSYS_WORKBENCH_PREWARM_ONLY:-0}"
SSH_WAIT_SECONDS="${ANSYS_MECHANICAL_SSH_WAIT_SECONDS:-180}"
WB_WAIT_SECONDS="${ANSYS_WORKBENCH_START_WAIT_SECONDS:-180}"
LICENSE_PORT="${ANSYS_LICENSE_PORT:-1055}"
LICENSING_CLIENT_PORT="${ANSYS_LICENSING_CLIENT_PORT:-1084}"
LICENSING_STABILITY_SECONDS="${ANSYS_LICENSING_STABILITY_SECONDS:-20}"
TUNNEL_WAIT_SECONDS="${ANSYS_MECHANICAL_TUNNEL_WAIT_SECONDS:-30}"
# A TCP listener can be present before Workbench's system-owned Mechanical
# server accepts real gRPC calls.  Do not report the runtime ready until a
# non-mutating PyMechanical round-trip has succeeded.
MECH_GRPC_WAIT_SECONDS="${ANSYS_MECHANICAL_GRPC_WAIT_SECONDS:-120}"
CONTROL_DIR="${TMPDIR:-/tmp}/ansys-mechanical-mcp-${UID}"
CONTROL_SOCKET="${CONTROL_DIR}/ssh-control"

# Windows path to the .wbpj to open. The internal Mechanical system name is
# optional: when omitted, the script discovers the one system that contains
# both Model and Solution components. An explicit name remains available for
# projects with more than one Mechanical system.
PROJECT_PATH="${1:-${ANSYS_WORKBENCH_PROJECT_PATH:-}}"
SYSTEM_NAME="${2:-${ANSYS_WORKBENCH_SYSTEM_NAME:-}}"

# Phase timing. A cold start is dominated by waiting, and the log used to say
# nothing about which wait cost what -- reconstructing it afterwards from
# Win32_OperatingSystem.LastBootUpTime and process start times only resolves
# the phases that happen to spawn a process. Every log line now carries its
# offset from script start, and a breakdown is printed on exit (including on
# failure, so a run that dies in licensing still shows where the time went).
T0=${SECONDS}
typeset -a PHASE_NAMES PHASE_TIMES

elapsed() {
  local e=$(( SECONDS - T0 ))
  printf '%02d:%02d' $(( e / 60 )) $(( e % 60 ))
}

log() { print -u2 -- "[ansys-workbench-runtime +$(elapsed)] $*"; }
fail() { log "ERROR: $*"; exit 1; }

mark() {
  PHASE_NAMES+=("$1")
  PHASE_TIMES+=("$(( SECONDS - T0 ))")
}

# This deliberately creates only a short-lived client.  ``cleanup_on_exit``
# must remain false: this is a Workbench-owned Mechanical process and this
# probe must never turn a client disconnect into a product shutdown.
# ``keep_connection_alive`` is false because the process exits immediately
# after the probe, so a heartbeat thread is neither necessary nor useful.
mechanical_grpc_healthcheck() {
  "${VENV_PYTHON}" - "${MECH_LOCAL_PORT}" <<'PYEOF'
import sys
import warnings

warnings.filterwarnings("ignore")
from ansys.mechanical.core import connect_to_mechanical

mechanical = connect_to_mechanical(
    ip="127.0.0.1",
    port=int(sys.argv[1]),
    transport_mode="insecure",
    connect_timeout=5,
    cleanup_on_exit=False,
    keep_connection_alive=False,
)
# A connection object alone is insufficient: this RPC verifies that the
# Workbench-owned Mechanical session can actually execute gRPC requests.
mechanical.run_python_script("1")
PYEOF
}

# Prefix each line a remote command emits with the elapsed time it arrived at.
# The Windows bootstrap prints its own progress (interactive session, network,
# licensing, Workbench start) and those lines are exactly the ones whose timing
# the shell cannot otherwise see.
stamp() { while IFS= read -r line; do print -u2 -- "[ansys-workbench-runtime +$(elapsed)] ${line}"; done }

summary() {
  local n=${#PHASE_NAMES[@]}
  (( n > 0 )) || return 0
  print -u2 -- "[ansys-workbench-runtime] --- phase timings (elapsed / duration) ---"
  local i prev=0 d
  for (( i = 1; i <= n; i++ )); do
    d=$(( PHASE_TIMES[i] - prev ))
    printf '[ansys-workbench-runtime]   %-32s %02d:%02d  (+%02d:%02d)\n' \
      "${PHASE_NAMES[i]}" \
      $(( PHASE_TIMES[i] / 60 )) $(( PHASE_TIMES[i] % 60 )) \
      $(( d / 60 )) $(( d % 60 )) >&2
    prev=${PHASE_TIMES[i]}
  done
  printf '[ansys-workbench-runtime]   %-32s %02d:%02d\n' "TOTAL" $(( prev / 60 )) $(( prev % 60 )) >&2
}

trap 'summary' EXIT

if [[ "${PREWARM_ONLY}" != "1" ]]; then
  [[ -n "${PROJECT_PATH}" ]] || fail "Usage: $0 <windows-wbpj-path> [system-name] (or set ANSYS_WORKBENCH_PROJECT_PATH / optional ANSYS_WORKBENCH_SYSTEM_NAME)"
fi
[[ -r "${WINDOWS_BOOTSTRAP}" ]] || fail "Windows bootstrap script not found: ${WINDOWS_BOOTSTRAP}"
if [[ "${PREWARM_ONLY}" != "1" ]]; then
  [[ -x "${VENV_PYTHON}" ]] || fail "venv python not found at ${VENV_PYTHON}; run 'pip install ansys-workbench-core' in it first"
fi

mkdir -p "${CONTROL_DIR}"
chmod 700 "${HOME}/.ssh" "${CONTROL_DIR}"

if command -v prlctl >/dev/null 2>&1; then
  VM_STATUS="$(prlctl status "${PARALLELS_VM}" 2>/dev/null || true)"
  if [[ "${VM_STATUS}" != *running* ]]; then
    log "Starting Parallels VM: ${PARALLELS_VM}"
    prlctl start "${PARALLELS_VM}" >&2 || fail "Could not start Parallels VM: ${PARALLELS_VM}"
  else
    log "Reusing running Parallels VM: ${PARALLELS_VM}"
  fi
  if [[ -d "${PARALLELS_VM_BUNDLE}" ]]; then
    # LaunchServices can wait indefinitely when this script is called from a
    # compiled AppleScript app, even though Parallels and the VM already run.
    # Opening the console is visual best-effort only; keep lifecycle readiness
    # tied to prlctl/SSH rather than to the macOS GUI activation round-trip.
    { open -a "Parallels Desktop" "${PARALLELS_VM_BUNDLE}" >&2 \
        || log "WARNING: VM is running, but the Parallels console could not be opened" } &!
  fi
fi
mark "vm running"

log "Waiting up to ${SSH_WAIT_SECONDS}s for passwordless SSH host '${SSH_HOST}'"
SSH_READY=0
SSH_DEADLINE=$(( SECONDS + SSH_WAIT_SECONDS ))
while (( SECONDS < SSH_DEADLINE )); do
  if ssh -o BatchMode=yes -o ConnectionAttempts=1 -o ConnectTimeout=1 "${SSH_HOST}" exit >/dev/null 2>&1; then
    SSH_READY=1
    break
  fi
  sleep 2
done
(( SSH_READY == 1 )) || fail "SSH did not become available within ${SSH_WAIT_SECONDS}s"
mark "ssh reachable"

log "Ensuring Workbench GUI is running with its project-schematic gRPC server on Windows port ${WB_GRPC_PORT}"
# The bootstrap is copied and run with -File rather than piped into
# "powershell -Command -". With stdin, PowerShell evaluates the input as
# separate statement groups: a `throw` only aborts the group it occurs in and
# execution continues with the next one, so guard clauses do not actually
# stop the script and the exit code does not reflect the failure. -File gives
# normal script semantics, where a throw terminates and sets a failing exit
# code that the `||` below can see.
# The Windows temp directory is per-user, so ask the VM for it rather than
# baking a username into this script. `-Command $env:TEMP` needs no quoting on
# either side, which keeps it robust across the Mac shell and the remote cmd.exe
# that ssh hands the command to. PowerShell accepts forward slashes, and
# converting to them avoids the \U mangling zsh would otherwise do later.
WINDOWS_TEMP="${ANSYS_WINDOWS_TEMP:-}"
if [[ -z "${WINDOWS_TEMP}" ]]; then
  WINDOWS_TEMP="$(ssh -o BatchMode=yes "${SSH_HOST}" \
    'powershell.exe -NoLogo -NoProfile -NonInteractive -Command $env:TEMP' | tr -d '\r')" \
    || fail "Could not determine the Windows temp directory on '${SSH_HOST}'"
fi
WINDOWS_TEMP="${WINDOWS_TEMP%%$'\n'*}"
[[ -n "${WINDOWS_TEMP}" ]] \
  || fail "The Windows temp directory came back empty from '${SSH_HOST}'; set ANSYS_WINDOWS_TEMP to override"
WINDOWS_TEMP="${${WINDOWS_TEMP//\\//}%/}"
REMOTE_BOOTSTRAP="${WINDOWS_TEMP}/Start-AnsysWorkbenchGrpc.ps1"
log "Windows temp directory: ${WINDOWS_TEMP}"

scp -q "${WINDOWS_BOOTSTRAP}" "${SSH_HOST}:${REMOTE_BOOTSTRAP}" \
  || fail "Could not copy the Workbench bootstrap script to Windows"
# PowerShell accepts forward slashes in paths, so no backslash conversion is
# needed (and attempting it in zsh mangles the path at the \U in \Users).
# Two things this line must not do: quote the path (the quotes survive the
# remote shell and land inside the -File argument, giving "unsupported path
# format"), and append `; exit $LASTEXITCODE` (the remote side runs through
# cmd.exe, which does not treat `;` as a separator, so it is glued onto the
# last argument as "180;"). With -File and a valid path, a throw inside the
# script already exits non-zero, which is what the `||` below relies on.
# 2>&1 | stamp instead of >&2: the bootstrap's own progress lines are the only
# view into the Windows-side waits, so they get elapsed-time prefixes too.
# `set -o pipefail` (above) keeps the ssh exit code authoritative for the `||`.
ssh -o BatchMode=yes "${SSH_HOST}" \
  "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ${REMOTE_BOOTSTRAP} -GrpcPort ${WB_GRPC_PORT} -StartupWaitSeconds ${WB_WAIT_SECONDS} -LicensePort ${LICENSE_PORT} -LicensingClientPort ${LICENSING_CLIENT_PORT} -LicensingStabilitySeconds ${LICENSING_STABILITY_SECONDS} -AnsysVersion ${ANSYS_VERSION} -ProjectPath \"${PROJECT_PATH}\"" 2>&1 | stamp \
  || fail "Windows could not start or verify the Workbench gRPC server"
mark "workbench grpc up"

if ssh -S "${CONTROL_SOCKET}" -O check "${SSH_HOST}" >/dev/null 2>&1; then
  log "Reusing managed SSH control connection"
else
  log "Opening SSH control connection (bare master, forwards added on demand)"
  ssh -M -S "${CONTROL_SOCKET}" -fN \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    "${SSH_HOST}" \
    || fail "Could not establish the SSH control connection"
fi

if ! lsof -nP -iTCP:"${WB_GRPC_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  log "Forwarding Workbench server port 127.0.0.1:${WB_GRPC_PORT}"
  ssh -S "${CONTROL_SOCKET}" -O forward -L "127.0.0.1:${WB_GRPC_PORT}:127.0.0.1:${WB_GRPC_PORT}" "${SSH_HOST}" \
    || fail "Could not forward the Workbench server port"
fi
mark "ssh tunnel established"

if [[ "${PREWARM_ONLY}" == "1" ]]; then
  mark "generic MCP warm state ready"
  print -- "Ansys MCP warm state is ready: VM, interactive Windows session, licensing, blank/reused Workbench, SSH control connection, and Workbench tunnel at 127.0.0.1:${WB_GRPC_PORT}."
  print -- "No project or Mechanical system was opened. The AI can now open the requested model and establish the Mechanical endpoint on demand."
  exit 0
fi

# start_mechanical_server() is not idempotent: each call replaces the running
# Mechanical process for that system, killing any session a client is already
# using. So if the standard endpoint already serves a live Mechanical, stop
# here and keep it, unless the caller explicitly asked for a fresh one.
if [[ "${ANSYS_WORKBENCH_FORCE_RESTART:-0}" != "1" ]] \
  && nc -z 127.0.0.1 "${MECH_LOCAL_PORT}" >/dev/null 2>&1; then
  if mechanical_grpc_healthcheck >/dev/null 2>&1; then
    mark "existing mechanical reused"
    if [[ -n "${SYSTEM_NAME}" ]]; then
      REUSED_SYSTEM_DESCRIPTION="system '${SYSTEM_NAME}'"
    else
      REUSED_SYSTEM_DESCRIPTION="the already running project system"
    fi
    print -- "Mechanical already reachable at 127.0.0.1:${MECH_LOCAL_PORT}; kept as-is (transport mode: insecure)"
    print -- "Set ANSYS_WORKBENCH_FORCE_RESTART=1 to replace ${REUSED_SYSTEM_DESCRIPTION} with a new server."
    exit 0
  fi
  log "127.0.0.1:${MECH_LOCAL_PORT} is open but not serving a live Mechanical; starting a new server"
fi

if [[ -n "${SYSTEM_NAME}" ]]; then
  log "Opening project and starting the Mechanical server for explicitly selected system '${SYSTEM_NAME}' (this can take a minute)"
else
  log "Opening project, discovering its Mechanical system, and starting that server (this can take a minute)"
fi
MECH_SERVER_RESULT="$(
  "${VENV_PYTHON}" - "${WB_GRPC_PORT}" "${PROJECT_PATH}" "${SYSTEM_NAME}" <<'PYEOF'
import json
import ntpath
import sys
import warnings

warnings.filterwarnings("ignore")
from ansys.workbench.core import connect_workbench

wb_port, project_path, requested_system_name = int(sys.argv[1]), sys.argv[2], sys.argv[3]
wb = connect_workbench(port=wb_port, host="127.0.0.1", security="insecure")

current_project = wb.run_script_string(
    "import json\nwb_script_result=json.dumps(GetProjectFile())"
)
if ntpath.normcase(ntpath.normpath(current_project or "")) != ntpath.normcase(
    ntpath.normpath(project_path)
):
    escaped_project_path = project_path.replace('"', '\\"')
    wb.run_script_string(f'Open(FilePath=r"{escaped_project_path}")')

systems_result = wb.run_script_string(
    "import json\n"
    "systems=[]\n"
    "for system in GetAllSystems():\n"
    # Workbench appends numeric suffixes to internal component names in shared
    # systems (for example ``Model 1``), while DisplayText remains the stable
    # Mechanical-system role used for discovery.
    "    components=[component.DisplayText for component in system.Components]\n"
    "    systems.append({'name':system.Name,'display_text':system.DisplayText,'components':components})\n"
    "wb_script_result=json.dumps(systems)"
)
# PyWorkbench 0.14 decodes wb_script_result JSON before returning it, while
# older clients may return the JSON text. Accept both without version guesses.
systems = json.loads(systems_result) if isinstance(systems_result, str) else systems_result
mechanical_systems = [
    system
    for system in systems
    if "Model" in system["components"] and "Solution" in system["components"]
]

if requested_system_name:
    matches = [system for system in mechanical_systems if system["name"] == requested_system_name]
    if not matches:
        available = ", ".join(
            f"{system['name']} ({system['display_text']})" for system in mechanical_systems
        ) or "none"
        raise RuntimeError(
            f"Requested system {requested_system_name!r} is not a Mechanical system. "
            f"Available Mechanical systems: {available}"
        )
    selected_system = matches[0]
elif len(mechanical_systems) == 1:
    selected_system = mechanical_systems[0]
elif not mechanical_systems:
    raise RuntimeError(
        "No Workbench system containing both Model and Solution was found in the project."
    )
else:
    available = ", ".join(
        f"{system['name']} ({system['display_text']})" for system in mechanical_systems
    )
    raise RuntimeError(
        "More than one Mechanical system was found; pass the desired internal system name "
        f"as argument 2 or ANSYS_WORKBENCH_SYSTEM_NAME. Candidates: {available}"
    )

system_name = selected_system["name"]
mech_port = wb.start_mechanical_server(system_name=system_name)
print(f"{system_name}\t{mech_port}")
PYEOF
)" || fail "PyWorkbench could not open the project or start the Mechanical server"

SYSTEM_NAME="${MECH_SERVER_RESULT%%$'\t'*}"
MECH_PORT="${MECH_SERVER_RESULT#*$'\t'}"
[[ -n "${SYSTEM_NAME}" && "${MECH_SERVER_RESULT}" == *$'\t'* ]] \
  || fail "Did not get a system name and Mechanical port back from PyWorkbench (got: '${MECH_SERVER_RESULT}')"
[[ "${MECH_PORT}" == <1-65535> ]] || fail "Did not get a valid Mechanical port back from PyWorkbench (got: '${MECH_PORT}')"
mark "project opened + mechanical started"
log "Mechanical server for system '${SYSTEM_NAME}' is listening on Windows port ${MECH_PORT}"

log "Remapping Windows port ${MECH_PORT} onto the standard local MCP endpoint 127.0.0.1:${MECH_LOCAL_PORT}"
# start_mechanical_server() can return a different remote port on every call
# (Workbench replaces the per-system Mechanical process each time it's asked
# to start one). `ssh -O cancel -L` requires the exact original bind+target
# spec, so the previously forwarded remote port is tracked in a state file --
# without this, a stale forward silently keeps serving a dead process instead
# of erroring, which is worse than failing loudly.
LAST_PORT_FILE="${CONTROL_DIR}/last-mech-port-${MECH_LOCAL_PORT}"
if [[ -r "${LAST_PORT_FILE}" ]]; then
  LAST_MECH_PORT="$(<"${LAST_PORT_FILE}")"
  if [[ "${LAST_MECH_PORT}" == <1-65535> && "${LAST_MECH_PORT}" != "${MECH_PORT}" ]]; then
    ssh -S "${CONTROL_SOCKET}" -O cancel -L "127.0.0.1:${MECH_LOCAL_PORT}:127.0.0.1:${LAST_MECH_PORT}" "${SSH_HOST}" >/dev/null 2>&1 || true
  fi
fi
if ! lsof -nP -iTCP:"${MECH_LOCAL_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  ssh -S "${CONTROL_SOCKET}" -O forward -L "127.0.0.1:${MECH_LOCAL_PORT}:127.0.0.1:${MECH_PORT}" "${SSH_HOST}" \
    || fail "Could not forward the Mechanical server port onto ${MECH_LOCAL_PORT}"
elif [[ "${LAST_MECH_PORT:-}" != "${MECH_PORT}" ]]; then
  fail "127.0.0.1:${MECH_LOCAL_PORT} is already bound and does not match the current Mechanical port ${MECH_PORT}. Cancel it manually (ssh -S ${CONTROL_SOCKET} -O cancel -L 127.0.0.1:${MECH_LOCAL_PORT}:127.0.0.1:<old-port> ${SSH_HOST}) or restart the SSH control connection."
fi
print -- "${MECH_PORT}" > "${LAST_PORT_FILE}"

TUNNEL_READY=0
TUNNEL_DEADLINE=$(( SECONDS + TUNNEL_WAIT_SECONDS ))
while (( SECONDS < TUNNEL_DEADLINE )); do
  if nc -z 127.0.0.1 "${MECH_LOCAL_PORT}" >/dev/null 2>&1; then
    TUNNEL_READY=1
    break
  fi
  sleep 1
done
(( TUNNEL_READY == 1 )) || fail "Mechanical tunnel did not become reachable on 127.0.0.1:${MECH_LOCAL_PORT} within ${TUNNEL_WAIT_SECONDS}s"
mark "mechanical port reachable"

log "Waiting up to ${MECH_GRPC_WAIT_SECONDS}s for the Workbench-owned Mechanical gRPC service"
MECH_GRPC_READY=0
MECH_GRPC_DEADLINE=$(( SECONDS + MECH_GRPC_WAIT_SECONDS ))
while (( SECONDS < MECH_GRPC_DEADLINE )); do
  if mechanical_grpc_healthcheck >/dev/null 2>&1; then
    MECH_GRPC_READY=1
    break
  fi
  sleep 2
done
(( MECH_GRPC_READY == 1 )) \
  || fail "Mechanical tunnel is open, but the Workbench-owned gRPC service did not answer a harmless PyMechanical request within ${MECH_GRPC_WAIT_SECONDS}s"
mark "mechanical grpc verified"

print -- "Mechanical (Workbench system '${SYSTEM_NAME}') ready at 127.0.0.1:${MECH_LOCAL_PORT} (transport mode: insecure; gRPC verified)"
